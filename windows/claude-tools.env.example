# claude-tools config. Copy to claude-tools.env (gitignored) and fill in;
# deploy.ps1 installs it next to claude-secret.py.

# OpenBao address (its CA goes in ~/.claude/secrets/bao-ca.pem)
BAO_ADDR=https://secrets.example.lan

# Full ntfy topic URL for approval requests (empty = no push)
CLAUDE_SECRET_NTFY=https://ntfy.example.com/openbao

# Shown in the push / messages: where the approver runs bao-approve
CLAUDE_SECRET_APPROVE_ON=the OpenBao host

# Optional: where tandoor-refresh-cache.sh writes (Git Bash path)
#TANDOOR_CACHE_DIR=/c/Users/you/.tandoor-cache
